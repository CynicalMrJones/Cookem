@page
@model TestModel


<div class="text-center">
    <form method="post">
        <p>This is a test page</p>

        <input asp-for="Num1">
        <label asp-for="Num1">Num1</label>

        <input asp-for="Num2">
        <label asp-for="Num2">Num2</label>

        <p class="TestClass">Num1: @Model.Num1</p>
        <p class="TestClass">Num2: @Model.Num2</p>

        <div>
            <input type="submit" value="submit" class="submit" onclick="@Model.Simple_Add(@Model.Num1, @Model.Num2)"/>
            <label>@Model.Ans</label>
        </div>
    </form>
</div>
