@page
@model InputModel


<div class="text-center">
    <form method="post">
        <div>
            <p>Add a Recipe</p>
            <!-- Let them add a name -->
            <label asp-for="Name">Name:</label>
            <input asp-for="Name">

            <!-- Let them add a Instructions -->
            <label asp-for="Instructions">Instructions:</label>
            <input asp-for="Instructions">

            <!-- Ingredient list seperated by commas -->
            <label asp-for="Ingredients">Ingredients:</label>
            <input asp-for="Ingredients">
        </div>

        <div>
            <input type="submit" value="submit" class="submit" onclick="@Model.AddRecipe(@Model.Name, @Model.Instructions, @Model.Ingredients)">
            <label>@Model.Ans</label>

        </div>

        <!-- <textarea class="textarea1" disabled></textarea> -->
    </form>
</div>
