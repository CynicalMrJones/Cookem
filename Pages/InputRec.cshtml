@page
@model InputModel


<div class="text-center">
    <form method="post">
        <div>
            <p>Add a Recipe</p>
            <!-- Let them add a name -->
            <label asp-for="Name">Name:</label>
            <input asp-for="Name">

            <!-- Let them add a Instructions -->
            <label asp-for="Instructions">Instructions:</label>
            <input asp-for="Instructions">
        </div>

        <div>
            <input type="submit" value="submit" class="submit" onclick="@Model.AddRecipe(@Model.Name, @Model.Instructions)">
            <label>@Model.Ans</label>

        </div>

        <div>
            <p>Add an ingredient</p>
            <!-- Let them add a name -->
            <label asp-for="Name_ingredient">Name:</label>
            <input asp-for="Name_ingredient">

        </div>
            <input type="submit" value="submit" class="submit" onclick="@Model.AddIngredient(@Model.Name_ingredient)">
            <label>@Model.Ans</label>

        <!-- <textarea class="textarea1" disabled></textarea> -->
    </form>
</div>
