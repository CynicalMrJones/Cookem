
@page
@model ViewModel 


<div class="text-center">
    <form method="post">
        <div>
            <p>View a Recipe</p>
            <!-- Let them add a name -->
            <!-- TODO: Make look better -->
            <form target="_blank" method="get">
                <p>Select recipe</p>
                <form method="post">
                    <select asp-for="Ans" asp-items="@Model.Recipes">
                        <option>Please Pick</option>
                    </select>
                </form>
                <input type="submit" value="submit" class="submit" onclick="@Model.GetText(@Model.Ans)">
                <textarea class="textarea1">@Model.Text</textarea>
            </form>
        </div>
    </form>
</div>
