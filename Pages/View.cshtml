
@page
@model ViewModel 


<div class="text-center">
    <form method="post">
        <div>
            <h1>View a Recipe</h1>
            <!-- Let them add a name -->
            <form target="_blank" method="get">
                <p>Select recipe</p>
                <form method="post">
                <div>
                    <input asp-for="Ans" type="text" list="recipeList" placeholder="Search..." onclick="
                                                                             @Model.GetText(@Model.Search);
                                                                             @Model.GetIngredientsText(@Model.Search)">
                    <datalist id="recipeList">
                        @foreach(var recipe in @Model.Recipes){
                        <option value="@recipe"></option>
                        }
                    </datalist>
                </div>
                    <!-- <select asp-for="Ans" asp-items="@Model.Recipes"> -->
                    <!--     <option>Please Pick</option> -->
                    <!-- </select> -->
                </form>
                <input type="submit" value="submit" class="submit" onclick="
                                                                   @Model.GetText(@Model.Ans);
                                                                   @Model.GetIngredientsText(@Model.Ans)">
            </form>
        </div>
        <div class=IandIArea>
            <div>
                <label>Ingredients</label>
                <br/>
                <textarea class="ingredientText" disabled>@Model.IngredientsText</textarea>
            </div>
            <div>
                <label>Instructions</label>
                <br/>
                <textarea class="instructionText" readonly disabled>@Model.Text</textarea>
            </div>
        </div>
    </form>
</div>
