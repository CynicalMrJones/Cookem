
@page
@model ViewModel 


<div class="text-center">
    <form method="post">
        <div>
            <h1>View a Recipe</h1>
            <!-- Let them add a name -->
            <form target="_blank" method="get">
                <p>Select recipe</p>
                <form method="post">
                    <select asp-for="Ans" asp-items="@Model.Recipes">
                        <option>Please Pick</option>
                    </select>
                </form>
                <input type="submit" value="submit" class="submit" onclick="
                @Model.GetText(@Model.Ans); @Model.GetIngredientsText(@Model.Ans)">
            </form>
        </div>
        <textarea class="textarea1" disabled>@Model.IngredientsText</textarea>
        <textarea class="textarea1" readonly disabled>@Model.Text</textarea>
    </form>
</div>
